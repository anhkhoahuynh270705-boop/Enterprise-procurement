	<detail>
		<band height="24" splitType="Stretch">
			<element kind="textField" x="0" y="0" width="65" height="24" forecolor="#334155" fontName="DejaVu Sans" fontSize="7.0" textAdjust="ScaleFont" vTextAlign="Middle"><box leftPadding="3"><pen lineWidth="0.4" lineColor="#CBD5E1"/></box><expression><![CDATA[$F{sku}]]></expression></element>
			<element kind="textField" x="65" y="0" width="225" height="24" forecolor="#0F172A" fontName="DejaVu Sans" fontSize="7.0" textAdjust="ScaleFont" vTextAlign="Middle"><box leftPadding="4"><pen lineWidth="0.4" lineColor="#CBD5E1"/></box><expression><![CDATA[$F{itemName}]]></expression></element>
