	<parameter name="CURRENCY" class="java.lang.String"/>
	<parameter name="EXPORTED_AT" class="java.lang.String"/>
	<parameter name="QUOTE_COUNT" class="java.lang.String"/>
	<parameter name="SCORING_WEIGHTS" class="java.lang.String"/>
	<parameter name="SELECTED_SUPPLIER" class="java.lang.String"/>
	<parameter name="SELECTION_REASON" class="java.lang.String"/>
	<field name="groupKey" class="java.lang.String"/>
	<field name="supplierName" class="java.lang.String"/>
	<field name="roundNumber" class="java.lang.String"/>
	<field name="sku" class="java.lang.String"/>
	<field name="itemName" class="java.lang.String"/>
	<field name="quantity" class="java.lang.String"/>
	<field name="unit" class="java.lang.String"/>
	<field name="budgetUnitPrice" class="java.lang.String"/>
	<field name="unitPrice" class="java.lang.String"/>
	<field name="lineTotal" class="java.lang.String"/>
	<field name="budgetVariance" class="java.lang.String"/>
	<field name="subtotalBeforeTax" class="java.lang.String"/>
	<field name="taxAmount" class="java.lang.String"/>
	<field name="shippingCost" class="java.lang.String"/>
	<field name="otherCost" class="java.lang.String"/>
	<field name="totalAfterTax" class="java.lang.String"/>
	<field name="deliveryDays" class="java.lang.String"/>
	<field name="paymentTerms" class="java.lang.String"/>
	<field name="warranty" class="java.lang.String"/>
	<field name="validUntil" class="java.lang.String"/>
	<field name="technicalStatus" class="java.lang.String"/>
	<field name="totalScore" class="java.lang.String"/>
	<field name="rank" class="java.lang.String"/>
	<field name="priceScore" class="java.lang.String"/>
	<field name="technicalScore" class="java.lang.String"/>
	<field name="deliveryScore" class="java.lang.String"/>
	<field name="paymentScore" class="java.lang.String"/>
	<field name="reputationScore" class="java.lang.String"/>
	<group name="SupplierGroup" reprintHeaderOnEachPage="true">
		<expression><![CDATA[$F{groupKey}]]></expression>
		<groupHeader>
			<band height="24" splitType="Stretch">
				<element kind="textField" x="0" y="0" width="802" height="24" forecolor="#FFFFFF" backcolor="#173F73" mode="Opaque" fontName="DejaVu Sans" fontSize="9.0" bold="true" vTextAlign="Middle">
					<box leftPadding="7"/><expression><![CDATA["NHÀ CUNG CẤP: " + $F{supplierName} + "    |    VÒNG " + $F{roundNumber} + "    |    " + $F{rank} + "    |    TỔNG ĐIỂM: " + $F{totalScore} + " / 100"]]></expression>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="62" splitType="Stretch">
				<element kind="textField" x="0" y="0" width="802" height="18" forecolor="#0F172A" backcolor="#EFF4F9" mode="Opaque" fontName="DejaVu Sans" fontSize="8.0" bold="true" vTextAlign="Middle">
					<box leftPadding="6"/><expression><![CDATA["TỔNG TRƯỚC VAT: " + $F{subtotalBeforeTax} + "    |    VAT: " + $F{taxAmount} + "    |    VẬN CHUYỂN: " + $F{shippingCost} + "    |    CHI PHÍ KHÁC: " + $F{otherCost} + "    |    TCO: " + $F{totalAfterTax}]]></expression>
				</element>
				<element kind="textField" x="0" y="19" width="802" height="17" forecolor="#334155" fontName="DejaVu Sans" fontSize="8.0" vTextAlign="Middle">
					<expression><![CDATA["GIAO HÀNG: " + $F{deliveryDays} + "    |    THANH TOÁN: " + $F{paymentTerms} + "    |    BẢO HÀNH: " + $F{warranty} + "    |    HIỆU LỰC ĐẾN: " + $F{validUntil} + "    |    KỸ THUẬT: " + $F{technicalStatus}]]></expression>
				</element>
				<element kind="textField" x="0" y="37" width="802" height="20" forecolor="#334155" fontName="DejaVu Sans" fontSize="7.0" vTextAlign="Middle">
					<expression><![CDATA["ĐIỂM TIÊU CHÍ ( /100): Giá " + $F{priceScore} + " · Kỹ thuật " + $F{technicalScore} + " · Giao hàng " + $F{deliveryScore} + " · Thanh toán " + $F{paymentScore} + " · Uy tín NCC " + $F{reputationScore}]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
	<title height="160" splitType="Stretch">
		<element kind="staticText" x="0" y="0" width="802" height="15" forecolor="#475569" fontName="DejaVu Sans" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[ENTERPRISE PROCUREMENT MANAGEMENT SYSTEM]]></text>
