		<element kind="textField" x="0" y="44" width="802" height="18" forecolor="#334155" fontName="DejaVu Sans" fontSize="10.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[$P{RFQ_CODE} + " · " + $P{RFQ_TITLE}]]></expression>
		</element>
		<element kind="textField" x="0" y="67" width="400" height="18" forecolor="#0F172A" backcolor="#EFF4F9" mode="Opaque" fontName="DejaVu Sans" fontSize="8.0" bold="true" vTextAlign="Middle">
			<box leftPadding="6"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
			<expression><![CDATA["MÃ PR: " + $P{PR_CODE} + "    |    PHÒNG BAN: " + $P{DEPARTMENT}]]></expression>
		</element>
		<element kind="textField" x="400" y="67" width="402" height="18" forecolor="#14532D" backcolor="#EFF4F9" mode="Opaque" fontName="DejaVu Sans" fontSize="8.0" bold="true" vTextAlign="Middle">
			<box leftPadding="6"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
			<expression><![CDATA["TRẠNG THÁI: " + $P{STATUS} + "    |    HẠN NHẬN: " + $P{DEADLINE}]]></expression>
		</element>
		<element kind="textField" x="0" y="87" width="400" height="18" forecolor="#0F172A" backcolor="#F8FAFC" mode="Opaque" fontName="DejaVu Sans" fontSize="8.0" vTextAlign="Middle">
			<box leftPadding="6"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
			<expression><![CDATA["NGƯỜI TẠO: " + $P{CREATOR} + "    |    SỐ NHÀ CUNG CẤP: " + $P{QUOTE_COUNT}]]></expression>
		</element>
		<element kind="textField" x="400" y="87" width="402" height="18" forecolor="#0F172A" backcolor="#F8FAFC" mode="Opaque" fontName="DejaVu Sans" fontSize="8.0" vTextAlign="Middle">
			<box leftPadding="6"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
			<expression><![CDATA["TRỌNG SỐ: " + $P{SCORING_WEIGHTS}]]></expression>
		</element>
		<element kind="textField" x="0" y="107" width="802" height="18" forecolor="#14532D" backcolor="#F0FDF4" mode="Opaque" fontName="DejaVu Sans" fontSize="8.0" bold="true" vTextAlign="Middle">
			<box leftPadding="6"><pen lineWidth="0.5" lineColor="#86EFAC"/></box>
			<expression><![CDATA["NHÀ CUNG CẤP ĐƯỢC CHỌN: " + $P{SELECTED_SUPPLIER}]]></expression>
		</element>
		<element kind="textField" x="0" y="127" width="802" height="24" forecolor="#334155" fontName="DejaVu Sans" fontSize="8.0" textAdjust="StretchHeight" blankWhenNull="true" vTextAlign="Top">
			<expression><![CDATA["LÝ DO / GHI CHÚ: " + $P{SELECTION_REASON} + "    |    ĐƠN VỊ TIỀN: " + $P{CURRENCY} + "    |    XUẤT LÚC: " + $P{EXPORTED_AT}]]></expression>
		</element>
	</title>
	<pageHeader height="18" splitType="Stretch">
		<element kind="textField" x="0" y="0" width="802" height="16" forecolor="#64748B" fontName="DejaVu Sans" fontSize="7.0" hTextAlign="Right" vTextAlign="Middle">
