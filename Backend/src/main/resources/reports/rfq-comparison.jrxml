<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="rfq-comparison" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="18" bottomMargin="18" uuid="419d640e-7372-45c0-97c0-688f7741e900">
	<style name="ReportText" default="true" fontName="DejaVu Sans" fontSize="8.0"/>
	<parameter name="RFQ_CODE" class="java.lang.String"/>
	<parameter name="RFQ_TITLE" class="java.lang.String"/>
	<parameter name="PR_CODE" class="java.lang.String"/>
	<parameter name="DEPARTMENT" class="java.lang.String"/>
	<parameter name="CREATOR" class="java.lang.String"/>
	<parameter name="STATUS" class="java.lang.String"/>
