# Hướng dẫn:
# 1. Sao chép file này thành '.env' trong thư mục Frontend:
#      cp .env.example .env
#    (hoặc trên Windows PowerShell: Copy-Item .env.example .env)
# 2. Điều chỉnh API_BASE_URL tương ứng với backend server của bạn.
# 3. Chạy 'npm run start' hoặc 'npm run build' để tự sinh src/environments/environment.ts.

# Public browser configuration. Never put private API keys or passwords here.
API_BASE_URL=http://localhost:8080/api
